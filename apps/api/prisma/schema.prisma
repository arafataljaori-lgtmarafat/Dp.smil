generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CaseStatus {
  active
  archived
}

enum MediaKind {
  source
  derived
  generated
}

enum MediaPurpose {
  source_photo
  mock_simulation_result
}

enum CreationProjectType {
  smile_simulation
  before_after_image
  before_after_video
}

enum GenerationStatus {
  queued
  processing
  succeeded
  failed
  cancelled
}

enum MediaUploadSessionStatus {
  created
  processing
  committed
  failed
  expired
}

enum UserStatus {
  pending_verification
  active
  disabled
}

enum AccountActionTokenPurpose {
  verify_email
  reset_password
}

enum AuditActorType {
  human
  system
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String
  normalizedEmail    String              @unique(map: "users_normalizedEmail_key")
  displayName        String
  status             UserStatus          @default(pending_verification)
  emailVerifiedAt    DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
  ownedCases         PatientCase[]       @relation("OwnedCases")
  ownedMedia         MediaAsset[]        @relation("OwnedMedia")
  ownedProjects      CreationProject[]   @relation("OwnedProjects")
  ownedJobs          GenerationJob[]     @relation("OwnedJobs")
  ownedVersions      GenerationVersion[]    @relation("OwnedVersions")
  ownedAuditEvents   AuditEvent[]           @relation("OwnedAuditEvents")
  ownedUploadSessions MediaUploadSession[] @relation("OwnedUploadSessions")
  ownedCreationDrafts CreationDraft[] @relation("OwnedCreationDrafts")
  ownedCreationRevisions CreationRevision[] @relation("OwnedCreationRevisions")
  createdCases       PatientCase[]       @relation("CaseCreator")
  createdMedia       MediaAsset[]        @relation("MediaCreator")
  createdProjects    CreationProject[]   @relation("ProjectCreator")
  humanAuditEvents   AuditEvent[]        @relation("AuditHumanActor")
  passwordCredential PasswordCredential?
  authSessions       AuthSession[]
  actionTokens       AccountActionToken[]
  securityEvents     SecurityEvent[]

  @@map("users")
}

model PatientCase {
  id             String            @id @default(uuid()) @db.Uuid
  ownerUserId    String            @db.Uuid
  displayLabel   String
  referenceCode  String?
  status         CaseStatus        @default(active)
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  createdById    String            @db.Uuid
  owner          User              @relation("OwnedCases", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy      User              @relation("CaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  mediaAssets    MediaAsset[]      @relation("CaseMedia")
  projects       CreationProject[] @relation("CaseProjects")
  generationJobs GenerationJob[]   @relation("CaseGenerationJobs")
  auditEvents    AuditEvent[]         @relation("CaseAuditEvents")
  uploadSessions MediaUploadSession[] @relation("CaseUploadSessions")
  creationDrafts CreationDraft[] @relation("CaseCreationDrafts")
  creationRevisions CreationRevision[] @relation("CaseCreationRevisions")

  @@index([ownerUserId, createdAt])
  @@unique([ownerUserId, id])
  @@map("cases")
}

model MediaAsset {
  id                       String              @id @default(uuid()) @db.Uuid
  ownerUserId              String              @db.Uuid
  caseId                   String              @db.Uuid
  kind                     MediaKind
  purpose                  MediaPurpose
  mimeType                 String
  byteSize                 Int
  width                    Int
  height                   Int
  sha256                   String              @db.Char(64)
  storageKey               String              @unique
  sourceMediaId            String?             @db.Uuid
  createdAt                DateTime            @default(now()) @db.Timestamptz(3)
  createdById              String              @db.Uuid
  owner                    User                @relation("OwnedMedia", fields: [ownerUserId], references: [id], onDelete: Restrict)
  patientCase              PatientCase         @relation("CaseMedia", fields: [ownerUserId, caseId], references: [ownerUserId, id], onDelete: Restrict)
  sourceMedia              MediaAsset?         @relation("MediaLineage", fields: [ownerUserId, sourceMediaId], references: [ownerUserId, id], onDelete: Restrict)
  sourceMediaWithinCase    MediaAsset?         @relation("MediaLineageWithinCase", fields: [ownerUserId, caseId, sourceMediaId], references: [ownerUserId, caseId, id], onDelete: Restrict)
  derivedAssets            MediaAsset[]        @relation("MediaLineage")
  derivedAssetsWithinCase  MediaAsset[]        @relation("MediaLineageWithinCase")
  createdBy                User                @relation("MediaCreator", fields: [createdById], references: [id], onDelete: Restrict)
  projectSources           CreationProject[]   @relation("ProjectSource")
  projectSourcesWithinCase CreationProject[]   @relation("ProjectSourceWithinCase")
  generationSources        GenerationJob[]     @relation("GenerationSource")
  generationOutputs        GenerationVersion[] @relation("GenerationOutput")
  generationOutputsWithinGraph GenerationVersion[] @relation("GenerationVersionOutputGraph")
  generationVersionSources GenerationVersion[] @relation("GenerationVersionSource")
  committedUploadSessions MediaUploadSession[] @relation("CommittedUploadMedia")
  creationAssetBindings CreationAssetBinding[] @relation("CreationBindingMedia")
  creationRevisionAssets CreationRevisionAsset[] @relation("CreationRevisionAssetMedia")

  @@index([ownerUserId, caseId, createdAt])
  @@index([ownerUserId, sha256])
  @@unique([ownerUserId, id])
  @@unique([ownerUserId, caseId, id])
  @@unique([ownerUserId, caseId, sourceMediaId, id])
  @@map("media_assets")
}

model MediaUploadSession {
  id               String                   @id @default(uuid()) @db.Uuid
  ownerUserId      String                   @db.Uuid
  caseId           String                   @db.Uuid
  idempotencyKey   String
  status           MediaUploadSessionStatus @default(created)
  createdAt        DateTime                 @default(now()) @db.Timestamptz(3)
  startedAt        DateTime?                @db.Timestamptz(3)
  finishedAt       DateTime?                @db.Timestamptz(3)
  expiresAt        DateTime                 @db.Timestamptz(3)
  processingToken  String?
  targetMediaId    String?                  @db.Uuid
  targetStorageKey String?
  committedMediaId String?                  @db.Uuid
  errorCode        String?
  storageCleanupPending Boolean              @default(false)
  owner            User                     @relation("OwnedUploadSessions", fields: [ownerUserId], references: [id], onDelete: Restrict)
  patientCase      PatientCase              @relation("CaseUploadSessions", fields: [ownerUserId, caseId], references: [ownerUserId, id], onDelete: Restrict)
  committedMedia   MediaAsset?              @relation("CommittedUploadMedia", fields: [ownerUserId, caseId, committedMediaId], references: [ownerUserId, caseId, id], onDelete: Restrict)

  @@unique([ownerUserId, caseId, idempotencyKey])
  @@unique([ownerUserId, id])
  @@index([ownerUserId, caseId, createdAt])
  @@index([status, expiresAt])
  @@index([status, startedAt])
  @@index([status, storageCleanupPending])
  @@index([ownerUserId, caseId, committedMediaId])
  @@map("media_upload_sessions")
}

model CreationProject {
  id             String            @id @default(uuid()) @db.Uuid
  ownerUserId    String            @db.Uuid
  caseId         String            @db.Uuid
  type           CreationProjectType
  sourceMediaId  String            @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  createdById    String            @db.Uuid
  // Phase 5 Stage 2 production creation idempotency. Null for every project type that
  // does not require idempotent creation (image, smile simulation): Postgres treats each
  // NULL in a unique index as distinct, so those rows never collide with one another or
  // with anything else. Populated only by before_after_video creation.
  // Uniqueness is owner-scoped (ownerUserId, idempotencyKey) — not case-scoped — because
  // the request fingerprint already encodes caseId: reusing the same key against a
  // different case must produce IdempotencyConflictError, not a second graph.
  idempotencyKey String?
  requestFingerprint String?       @db.Char(64)
  owner          User              @relation("OwnedProjects", fields: [ownerUserId], references: [id], onDelete: Restrict)
  patientCase    PatientCase       @relation("CaseProjects", fields: [ownerUserId, caseId], references: [ownerUserId, id], onDelete: Restrict)
  sourceMedia    MediaAsset        @relation("ProjectSource", fields: [ownerUserId, sourceMediaId], references: [ownerUserId, id], onDelete: Restrict)
  sourceMediaWithinCase MediaAsset @relation("ProjectSourceWithinCase", fields: [ownerUserId, caseId, sourceMediaId], references: [ownerUserId, caseId, id], onDelete: Restrict)
  createdBy      User              @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  generationJobs GenerationJob[]   @relation("ProjectGenerationJobs")
  generationJobsWithinGraph GenerationJob[] @relation("JobProjectGraph")
  auditEvents    AuditEvent[]      @relation("AuditProject")
  auditEventsWithinGraph AuditEvent[] @relation("AuditProjectGraph")
  draft CreationDraft? @relation("ProjectCreationDraft")
  assetBindings CreationAssetBinding[] @relation("ProjectCreationAssetBindings")
  creationRevisions CreationRevision[] @relation("ProjectCreationRevisions")

  @@index([ownerUserId, caseId, createdAt])
  @@unique([ownerUserId, id])
  @@unique([ownerUserId, caseId, id])
  @@unique([ownerUserId, caseId, id, sourceMediaId])
  @@unique([ownerUserId, idempotencyKey])
  @@map("creation_projects")
}

model CreationAssetBinding {
  projectId   String @db.Uuid
  ownerUserId String @db.Uuid
  caseId      String @db.Uuid
  bindingKey  String
  mediaId     String @db.Uuid
  project     CreationProject @relation("ProjectCreationAssetBindings", fields: [ownerUserId, caseId, projectId], references: [ownerUserId, caseId, id], onDelete: Cascade)
  media       MediaAsset @relation("CreationBindingMedia", fields: [ownerUserId, caseId, mediaId], references: [ownerUserId, caseId, id], onDelete: Restrict)

  @@id([projectId, bindingKey])
  @@index([ownerUserId, caseId, mediaId])
  @@map("creation_asset_bindings")
}

model CreationDraft {
  projectId      String @id @db.Uuid
  ownerUserId    String @db.Uuid
  caseId         String @db.Uuid
  schemaVersion  Int
  document       Json
  revision       Int @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  project        CreationProject @relation("ProjectCreationDraft", fields: [ownerUserId, caseId, projectId], references: [ownerUserId, caseId, id], onDelete: Cascade)
  owner          User @relation("OwnedCreationDrafts", fields: [ownerUserId], references: [id], onDelete: Restrict)
  patientCase    PatientCase @relation("CaseCreationDrafts", fields: [ownerUserId, caseId], references: [ownerUserId, id], onDelete: Restrict)

  @@unique([ownerUserId, caseId, projectId])
  @@index([ownerUserId, caseId, updatedAt])
  @@map("creation_drafts")
}

model CreationRevision {
  id                    String @id @default(uuid()) @db.Uuid
  ownerUserId           String @db.Uuid
  caseId                String @db.Uuid
  projectId             String @db.Uuid
  revisionNumber        Int
  documentSchemaVersion Int
  document              Json
  documentSha256        String @db.Char(64)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  project               CreationProject @relation("ProjectCreationRevisions", fields: [ownerUserId, caseId, projectId], references: [ownerUserId, caseId, id], onDelete: Restrict)
  owner                 User @relation("OwnedCreationRevisions", fields: [ownerUserId], references: [id], onDelete: Restrict)
  patientCase           PatientCase @relation("CaseCreationRevisions", fields: [ownerUserId, caseId], references: [ownerUserId, id], onDelete: Restrict)
  assets                CreationRevisionAsset[] @relation("RevisionCreationAssets")

  @@unique([projectId, revisionNumber])
  @@unique([ownerUserId, caseId, projectId, id])
  @@index([ownerUserId, caseId, projectId, createdAt])
  @@map("creation_revisions")
}

model CreationRevisionAsset {
  revisionId  String @db.Uuid
  ownerUserId String @db.Uuid
  caseId      String @db.Uuid
  projectId   String @db.Uuid
  bindingKey  String
  mediaId     String @db.Uuid
  revision    CreationRevision @relation("RevisionCreationAssets", fields: [ownerUserId, caseId, projectId, revisionId], references: [ownerUserId, caseId, projectId, id], onDelete: Restrict)
  media       MediaAsset @relation("CreationRevisionAssetMedia", fields: [ownerUserId, caseId, mediaId], references: [ownerUserId, caseId, id], onDelete: Restrict)

  @@id([revisionId, bindingKey])
  @@index([ownerUserId, caseId, mediaId])
  @@map("creation_revision_assets")
}

model GenerationJob {
  id                        String              @id @default(uuid()) @db.Uuid
  ownerUserId               String              @db.Uuid
  caseId                    String              @db.Uuid
  projectId                 String              @db.Uuid
  sourceMediaId             String              @db.Uuid
  idempotencyKey            String
  requestFingerprint        String              @db.Char(64)
  generationContractVersion String
  correlationId             String
  providerKey               String
  status                    GenerationStatus    @default(queued)
  createdAt                 DateTime            @default(now()) @db.Timestamptz(3)
  startedAt                 DateTime?           @db.Timestamptz(3)
  finishedAt                DateTime?           @db.Timestamptz(3)
  errorCode                 String?
  owner                     User                @relation("OwnedJobs", fields: [ownerUserId], references: [id], onDelete: Restrict)
  patientCase               PatientCase         @relation("CaseGenerationJobs", fields: [ownerUserId, caseId], references: [ownerUserId, id], onDelete: Restrict)
  project                   CreationProject     @relation("ProjectGenerationJobs", fields: [ownerUserId, projectId], references: [ownerUserId, id], onDelete: Restrict)
  projectWithinGraph        CreationProject     @relation("JobProjectGraph", fields: [ownerUserId, caseId, projectId, sourceMediaId], references: [ownerUserId, caseId, id, sourceMediaId], onDelete: Restrict)
  sourceMedia               MediaAsset          @relation("GenerationSource", fields: [ownerUserId, sourceMediaId], references: [ownerUserId, id], onDelete: Restrict)
  versions                  GenerationVersion[]
  versionsWithinGraph       GenerationVersion[] @relation("VersionJobGraph")
  auditEvents               AuditEvent[]        @relation("AuditGenerationJob")
  auditEventsWithinGraph    AuditEvent[]        @relation("AuditJobGraph")

  @@unique([ownerUserId, projectId, idempotencyKey])
  @@index([ownerUserId, requestFingerprint])
  @@index([ownerUserId, caseId, createdAt])
  @@index([ownerUserId, status, createdAt])
  @@unique([ownerUserId, id])
  @@unique([ownerUserId, caseId, projectId, id])
  @@unique([ownerUserId, id, caseId, projectId, sourceMediaId], map: "generation_jobs_ownerUserId_id_caseId_projectId_sourceMediaId_k")
  @@map("generation_jobs")
}

model GenerationVersion {
  id                        String        @id @default(uuid()) @db.Uuid
  ownerUserId               String        @db.Uuid
  generationJobId           String        @db.Uuid
  mediaAssetId              String        @db.Uuid
  caseId                    String        @db.Uuid
  projectId                 String        @db.Uuid
  versionNumber             Int
  sourceMediaId             String        @db.Uuid
  sourceSha256              String        @db.Char(64)
  providerKey               String
  providerVersion           String
  generationContractVersion String
  parameters                Json
  createdAt                 DateTime      @default(now()) @db.Timestamptz(3)
  owner                     User          @relation("OwnedVersions", fields: [ownerUserId], references: [id], onDelete: Restrict)
  generationJob             GenerationJob @relation(fields: [ownerUserId, generationJobId], references: [ownerUserId, id], onDelete: Restrict)
  mediaAsset                MediaAsset    @relation("GenerationOutput", fields: [ownerUserId, mediaAssetId], references: [ownerUserId, id], onDelete: Restrict)
  sourceMedia               MediaAsset    @relation("GenerationVersionSource", fields: [ownerUserId, sourceMediaId], references: [ownerUserId, id], onDelete: Restrict)
  outputWithinGraph         MediaAsset    @relation("GenerationVersionOutputGraph", fields: [ownerUserId, caseId, sourceMediaId, mediaAssetId], references: [ownerUserId, caseId, sourceMediaId, id], onDelete: Restrict, map: "generation_versions_ownerUserId_caseId_sourceMediaId_mediaAsset")
  jobWithinGraph            GenerationJob @relation("VersionJobGraph", fields: [ownerUserId, generationJobId, caseId, projectId, sourceMediaId], references: [ownerUserId, id, caseId, projectId, sourceMediaId], onDelete: Restrict, map: "generation_versions_ownerUserId_generationJobId_caseId_projectI")

  @@unique([generationJobId, versionNumber])
  @@unique([ownerUserId, id])
  @@index([ownerUserId, generationJobId])
  @@map("generation_versions")
}

model PasswordCredential {
  userId             String   @id @db.Uuid
  passwordHash       String
  passwordChangedAt  DateTime @db.Timestamptz(3)
  credentialRevision Int      @default(1)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("password_credentials")
}

model AuthSession {
  id               String    @id @db.Uuid
  userId           String    @db.Uuid
  tokenHash        String    @unique(map: "auth_sessions_tokenHash_key") @db.Char(64)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt       DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  revocationReason String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model AccountActionToken {
  id         String                     @id @db.Uuid
  userId     String                     @db.Uuid
  purpose    AccountActionTokenPurpose
  tokenHash  String                     @unique(map: "account_action_tokens_tokenHash_key") @db.Char(64)
  createdAt  DateTime                   @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime                   @db.Timestamptz(3)
  consumedAt DateTime?                  @db.Timestamptz(3)
  revokedAt  DateTime?                  @db.Timestamptz(3)
  user       User                       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, expiresAt])
  @@map("account_action_tokens")
}

model SecurityEvent {
  id         String    @id @db.Uuid
  userId     String?   @db.Uuid
  eventType  String
  occurredAt DateTime  @db.Timestamptz(3)
  requestId  String
  metadata   Json      @default("{}")
  user       User?     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, occurredAt])
  @@map("security_events")
}

model AuditEvent {
  id                        String           @id @default(uuid()) @db.Uuid
  ownerUserId               String           @db.Uuid
  actorType                 AuditActorType
  actorUserId               String?          @db.Uuid
  systemActorKey            String?
  eventType                 String
  caseId                    String?          @db.Uuid
  projectId                 String?          @db.Uuid
  generationJobId           String?          @db.Uuid
  occurredAt                DateTime         @db.Timestamptz(3)
  correlationId             String
  metadata                  Json
  owner                     User             @relation("OwnedAuditEvents", fields: [ownerUserId], references: [id], onDelete: Restrict)
  actorUser                 User?            @relation("AuditHumanActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  patientCase               PatientCase?     @relation("CaseAuditEvents", fields: [ownerUserId, caseId], references: [ownerUserId, id], onDelete: Restrict)
  project                   CreationProject? @relation("AuditProject", fields: [ownerUserId, projectId], references: [ownerUserId, id], onDelete: Restrict)
  generationJob             GenerationJob?   @relation("AuditGenerationJob", fields: [ownerUserId, generationJobId], references: [ownerUserId, id], onDelete: Restrict)
  projectWithinGraph        CreationProject? @relation("AuditProjectGraph", fields: [ownerUserId, caseId, projectId], references: [ownerUserId, caseId, id], onDelete: Restrict)
  generationJobWithinGraph  GenerationJob?   @relation("AuditJobGraph", fields: [ownerUserId, caseId, projectId, generationJobId], references: [ownerUserId, caseId, projectId, id], onDelete: Restrict)

  @@index([ownerUserId, caseId, occurredAt])
  @@index([ownerUserId, generationJobId, occurredAt])
  @@index([ownerUserId, actorUserId, occurredAt])
  @@map("audit_events")
}


model AuthRateLimitBucket {
  scope       String
  keyHash     String   @db.Char(64)
  windowStart DateTime @db.Timestamptz(3)
  windowEnd   DateTime @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([scope, keyHash, windowStart])
  @@index([scope, keyHash, windowEnd], map: "auth_rate_limit_buckets_lookup_idx")
  @@map("auth_rate_limit_buckets")
}
