{
  "name": "dentpilot-smile",
  "version": "0.1.0",
  "private": true,
  "description": "DentPilot Smile Studio — Phase 0 and Phase 1 engineering foundation.",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "pnpm --filter @dentpilot/api dev",
    "dev:mobile": "pnpm --filter @dentpilot/mobile dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch --parallel",
    "test:integration": "pnpm --filter @dentpilot/api test:integration",
    "build": "turbo run build",
    "db:migrate": "pnpm --filter @dentpilot/api prisma:migrate",
    "db:seed": "pnpm --filter @dentpilot/api prisma:seed",
    "db:reset": "pnpm --filter @dentpilot/api prisma:reset",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^3.1.1"
  }
}
