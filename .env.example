# API runtime
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
DATABASE_URL=postgresql://YOUR_POSTGRES_USER:YOUR_POSTGRES_PASSWORD@localhost:5432/dentpilot_smile?schema=public
# Local is permitted for development/tests only. Production requires OBJECT_STORAGE_DRIVER=s3.
OBJECT_STORAGE_DRIVER=local
LOCAL_OBJECT_STORAGE_ROOT=./.local/object-storage
# Required for OBJECT_STORAGE_DRIVER=s3. Keep the production bucket private, block public access,
# and enable storage-provider encryption at rest. The application never creates buckets or uses public ACLs.
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=dentpilot-private-media
S3_FORCE_PATH_STYLE=false
# Use a workload/instance role where possible. Otherwise set both explicit values outside source control.
# S3_ACCESS_KEY_ID=replace-me
# S3_SECRET_ACCESS_KEY=replace-me
# Optional generic server-side encryption setting: AES256 or aws:kms.
# S3_SERVER_SIDE_ENCRYPTION=AES256
# S3_SSE_KMS_KEY_ID=replace-me
MAX_MEDIA_BYTES=10485760
# Maximum canonical UTF-8 JSON size for one structured CreationDocument v1 draft/revision.
MAX_CREATION_DOCUMENT_BYTES=16384
# Compatibility collector used only by existing byte-oriented consumers; Phase 3B will stream ingest.
MEDIA_STREAM_COLLECTION_MAX_BYTES=10485760
MAX_MEDIA_DIMENSION=6000
MAX_MEDIA_PIXELS=36000000
# Server-controlled private staging area; never expose it through a static/public mount.
MEDIA_TEMP_ROOT=./.local/media-temp
MEDIA_TEMP_CLEANUP_AGE_SECONDS=86400
MAX_CONCURRENT_MEDIA_INSPECTIONS=2
# Lifetime of an unclaimed session only; it must not expire a session that already entered processing.
MEDIA_UPLOAD_SESSION_TTL_SECONDS=3600
# Processing has an independent reconciler timeout and fails with UPLOAD_PROCESSING_TIMEOUT.
MEDIA_UPLOAD_PROCESSING_TIMEOUT_SECONDS=900
# Bounded recurring recovery; no cycle starts while the previous cycle is active.
MEDIA_RECONCILIATION_INTERVAL_SECONDS=60
MEDIA_RECONCILIATION_BATCH_SIZE=100
MOCK_GENERATION_DELAY_MS=250

# Mobile development only. Do not place secrets in the Expo public environment.
# Use a simulator/device-reachable API host, never a backend secret.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Phase 2A.1 identity and authentication primitives
# Session expiry is absolute; no sliding expiration is implemented in this phase.
SESSION_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
# Argon2id v=19: 64 MiB memory, 3 passes, one lane.
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Phase 2A.2 email delivery, opaque sessions and persistent rate limiting
# Development writes private 0600 JSON messages under DEVELOPMENT_EMAIL_OUTBOX_ROOT.
EMAIL_DELIVERY_MODE=development
DEVELOPMENT_EMAIL_OUTBOX_ROOT=./.local/email-outbox
# Expo deep-link receiver for verify/reset emails in development. Configure a production verified link host separately.
AUTH_ACTION_URL_BASE=dentpilot://auth/action
SESSION_LAST_SEEN_UPDATE_SECONDS=900
# Replace before production. Production requires SMTP and a non-development secret >= 32 characters.
AUTH_RATE_LIMIT_HMAC_SECRET=replace-with-a-unique-secret-of-at-least-32-characters
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_LOGIN_EMAIL_MAX=10
AUTH_RATE_LIMIT_LOGIN_IP_MAX=30
AUTH_RATE_LIMIT_REGISTER_IP_MAX=10
AUTH_RATE_LIMIT_VERIFY_IP_MAX=20
AUTH_RATE_LIMIT_RESEND_EMAIL_MAX=5
AUTH_RATE_LIMIT_RESEND_IP_MAX=20
AUTH_RATE_LIMIT_FORGOT_EMAIL_MAX=5
AUTH_RATE_LIMIT_FORGOT_IP_MAX=20
AUTH_RATE_LIMIT_RESET_IP_MAX=20
# Set true only behind a trusted reverse proxy that overwrites forwarded client-IP headers.
TRUST_PROXY=false
# Comma-separated exact browser origins; wildcard origins are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Required only when NODE_ENV=production and EMAIL_DELIVERY_MODE=smtp.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=replace-me
# SMTP_PASSWORD=replace-me
# SMTP_FROM=security@example.com
